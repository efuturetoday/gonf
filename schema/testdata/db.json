                      "type": "integer"
                    },
                    {
                      "pattern": "\\$\\{",
                      "type": "string"
                    }
                  ],
                  "default": 10,
                  "description": "Maximum number of open connections.",
                  "markdownDescription": "Maximum number of open connections."
                }
              },
              "type": "object"
            },
            "port": {
              "anyOf": [
                {
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
