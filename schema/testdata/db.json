                      "type": "integer"
                    },
                    {
                      "pattern": "\\$\\{",
                      "type": "string"
                    }
                  ],
                  "default": 5432
                }
              },
              "type": "object"
            },
            "replicas": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "host": {
                    "type": "string"
                  }
