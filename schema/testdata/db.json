                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "string"
                }
              ],
              "default": "a,b"
            },
            "timeout": {
              "default": "5s",
              "type": "string"
            },
            "url": {
              "description": "Address of the **database**.",
              "markdownDescription": "Address of the **database**.",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "^%[^.]+\\.": true
