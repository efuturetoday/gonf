{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "patternProperties": {
    "^%[^.]+$": {
      "properties": {
        "db": {
          "additionalProperties": false,
          "properties": {
            "debug": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "pattern": "\\$\\{",
                  "type": "string"
                }
              ],
              "default": true
            },
            "labels": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "password": {
              "description": "Password of the user.",
